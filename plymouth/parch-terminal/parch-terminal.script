Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

box_img = Image("box.png");
cursor_img = Image("cursor.png");

cols = 25;
rows = 3;
cursor_col = 18;
cursor_row = 1;

cell_w = box_img.GetWidth() / cols;
cell_h = box_img.GetHeight() / rows;

x = Math.Int(Window.GetWidth() / 2 - box_img.GetWidth() / 2);
y = Math.Int(Window.GetHeight() / 2 - box_img.GetHeight() / 2);

box_sprite = Sprite(box_img);
box_sprite.SetPosition(x, y, 10);

cursor_sprite = Sprite(cursor_img);
cursor_sprite.SetPosition(x + Math.Int(cursor_col * cell_w), y + Math.Int(cursor_row * cell_h), 11);

frame = 0;
fun refresh_callback() {
  frame++;
  cursor_sprite.SetOpacity(0.55 + 0.45 * Math.Sin(frame / 12));
}
Plymouth.SetRefreshFunction(refresh_callback);
